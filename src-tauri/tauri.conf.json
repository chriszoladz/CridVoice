{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CridVoice",
  "version": "0.1.18",
  "identifier": "com.cridvoice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CridVoice",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#101014",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/python/": "python/",
      "resources/service/": "service/",
      "resources/help/": "help/",
      "resources/model-catalog.json": "model-catalog.json"
    },
    "shortDescription": "Your voice, clearly written.",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Polish"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "CridVoice"
      }
    }
  }
}
